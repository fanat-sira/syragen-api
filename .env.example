# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Numeric Telegram User ID of the bot administrator (get from @userinfobot or similar)
TELEGRAM_ADMIN_ID=

# OpenRouter Management API Key (from https://openrouter.ai/settings/management-keys)
OPENROUTER_MANAGEMENT_KEY=

# Optional configuration (defaults shown):
# TIMEZONE=Europe/Moscow
# DAILY_SPEND_LIMIT=4.0
# Models are selected through /settings; video uses Grok Imagine Video 1.5.
# REQUEST_TIMEOUT=4m
# DATA_DIR=data
# RUNTIME_DIR=runtime
